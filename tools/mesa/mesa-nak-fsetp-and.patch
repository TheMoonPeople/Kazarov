+                    assert_eq!((original >> 39) & 7, 7);
+                    assert_eq!((fused >> 39) & 7, 2);
+                    assert_eq!((fused >> 42) & 1, 0);
+                    assert_eq!((fused >> 45) & 3, 0);
+                    assert_eq!((fused >> 3) & 7, 3);
+                    assert_eq!(fused & 7, 7);
+                }
+            }
