+            FloatCmpOp::UnordEq,
+            FloatCmpOp::UnordNe,
+            FloatCmpOp::UnordLt,
+            FloatCmpOp::UnordLe,
+            FloatCmpOp::UnordGt,
+            FloatCmpOp::UnordGe,
+            FloatCmpOp::IsNum,
+            FloatCmpOp::IsNan,
+        ];
+        for cmp_op in comparisons {
+            for ftz in [false, true] {
+                for modifier in
+                    [SrcMod::None, SrcMod::FAbs, SrcMod::FNeg, SrcMod::FNegAbs]
+                {
+                    for rhs_modifier in [
+                        SrcMod::None,
