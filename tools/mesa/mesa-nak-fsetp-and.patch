+        for cmp_op in [FloatCmpOp::OrdEq, FloatCmpOp::OrdNe, FloatCmpOp::OrdLt,
+            FloatCmpOp::OrdLe, FloatCmpOp::OrdGt, FloatCmpOp::OrdGe,
+            FloatCmpOp::UnordEq, FloatCmpOp::UnordNe, FloatCmpOp::UnordLt,
+            FloatCmpOp::UnordLe, FloatCmpOp::UnordGt, FloatCmpOp::UnordGe,
+            FloatCmpOp::IsNum, FloatCmpOp::IsNan] {
+            for ftz in [false, true] {
+                for modifier in [SrcMod::None, SrcMod::FAbs, SrcMod::FNeg, SrcMod::FNegAbs] {
+                    let encode = |accum: Src| {
+                        let mut lhs: Src = RegRef::new(RegFile::GPR, 0, 1).into();
+                        lhs.src_mod = modifier;
+                        let mut rhs: Src = RegRef::new(RegFile::GPR, 1, 1).into();
+                        rhs.src_mod = SrcMod::FNegAbs;
+                        let op = OpFSetP {dst: RegRef::new(RegFile::Pred, 3, 1).into(),
+                            set_op: PredSetOp::And, cmp_op, srcs: [lhs, rhs], accum, ftz};
+                        let mut encoder = SM50Encoder {sm: &sm, ip: 0, labels: &labels,
+                            inst: [0; 2], sched: 0};
+                        op.encode(&mut encoder);
+                        u64::from(encoder.inst[0]) | (u64::from(encoder.inst[1]) << 32)
+                    };
