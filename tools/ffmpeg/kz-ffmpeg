#!/usr/bin/env python3
"""Build a minimal LGPL-only FFmpeg into DIR and stamp it.

    kz-ffmpeg --out DIR [--target ios-arm64|switch-arm64|windows-x64] [--tarball FILE] [--sha256 HEX] [--jobs N] [--check] [--print-configure]

The build provides lossless MPEG-2/ALAC MP4 extraction and MP4 playback through
static codec, format, resampling and scaling libraries plus the FFmpeg command.
The Linux image and macOS hosts use it.
--target ios-arm64 cross-compiles the libraries for iOS on a macOS host, without the command.
--target switch-arm64 cross-compiles the libraries with devkitA64/libnx, without the command.
--target windows-x64 cross-compiles DLLs, their import libraries and the command for Windows on a Linux host with
llvm-mingw's x86_64-w64-mingw32- tools on PATH.
scripts/build/kz-ffmpeg launches this shared FFmpeg tool; the image uses it directly.
"""

import argparse
import hashlib
from http.client import HTTPException
import json
import os
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path

VERSION = '9.0.2'
URL = f'https://ffmpeg.org/releases/ffmpeg-{VERSION}.tar.xz'
SHA256 = '8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e'
LICENSE_LINE = 'License: LGPL version 2.1 or later'
STAMP = 'kz-ffmpeg.json'
LIBRARIES = ('lib/libavcodec.a', 'lib/libavformat.a', 'lib/libavutil.a',
             'lib/libswresample.a', 'lib/libswscale.a', 'include/libavcodec/avcodec.h')
WINDOWS_PRODUCTS = ('lib/libavcodec.dll.a', 'lib/libavformat.dll.a', 'lib/libavutil.dll.a', 'lib/libswresample.dll.a',
                    'lib/libswscale.dll.a', 'include/libavcodec/avcodec.h', 'bin/ffmpeg.exe')
IOS_MIN_VERSION = '16.0'
CONFIGURE_FLAGS = [
    '--disable-everything',
    '--disable-programs',
    '--enable-ffmpeg',
    '--disable-doc',
    '--disable-network',
    '--disable-autodetect',
    '--enable-avformat',
    '--enable-avfilter',
    '--enable-swscale',
    '--enable-swresample',
    '--disable-avdevice',
    '--enable-decoder=mpeg2video,h264,alac,aac,pcm_s16le',
    '--enable-parser=mpegvideo,h264,aac',
    '--enable-encoder=alac',
    # MPEG-PS probes its video codec through the raw MPEG video demuxer.
    '--enable-demuxer=mpegps,mov,wav,mpegvideo',
    '--enable-muxer=mp4',
    '--enable-protocol=file',
    '--enable-filter=aresample,aformat,anull,abuffer,abuffersink',
    '--enable-pic',
    '--disable-shared',
    '--enable-static',
]
GPL_FLAGS = ('--enable-gpl', '--enable-nonfree', '--enable-version3')


def products(target):
    if target in ('ios-arm64', 'switch-arm64'):
        return LIBRARIES
    if target == 'windows-x64':
        return WINDOWS_PRODUCTS
    return LIBRARIES + ('bin/ffmpeg',)


def ios_flags():
    # An iOS app cannot start processes, so only the libraries are built.
    sysroot = subprocess.run(['xcrun', '--sdk', 'iphoneos', '--show-sdk-path'], capture_output=True, text=True,
                             check=True).stdout.strip()
    target = f'-arch arm64 -mios-version-min={IOS_MIN_VERSION}'
    return ['--enable-cross-compile', '--target-os=darwin', '--arch=aarch64', '--cc=xcrun -sdk iphoneos clang',
            f'--sysroot={sysroot}', f'--extra-cflags={target}', f'--extra-ldflags={target}']


def switch_flags():
    devkitpro = Path(os.environ.get('DEVKITPRO', '/opt/devkitpro'))
    libnx = devkitpro / 'libnx'
    cflags = ('-D__SWITCH__ -D_GNU_SOURCE -O2 -march=armv8-a+crc+crypto -mtune=cortex-a57 '
              f'-mtp=soft -fPIC -ftls-model=local-exec -I{libnx / "include"}')
    ldflags = (f'-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE '
               f'-specs={libnx / "switch.specs"} -L{libnx / "lib"}')
    return ['--enable-cross-compile', '--target-os=none', '--arch=aarch64',
            '--cross-prefix=aarch64-none-elf-', '--cc=aarch64-none-elf-gcc',
            f'--extra-cflags={cflags}', f'--extra-ldflags={ldflags}', '--extra-libs=-lnx -lpthread -lm']
def windows_flags():
    # Windows links the libraries as DLLs, which keeps relinking them trivial. The static libunwind keeps the DLLs
    # free of llvm-mingw's runtime DLLs.
    return ['--enable-cross-compile', '--target-os=mingw32', '--arch=x86_64', '--cross-prefix=x86_64-w64-mingw32-',
            '--cc=x86_64-w64-mingw32-clang', '--enable-w32threads', '--extra-ldflags=-static-libgcc']


def configure_flags(target=None):
    flags = list(CONFIGURE_FLAGS)
    if target == 'ios-arm64':
        flags.remove('--enable-ffmpeg')
        flags += ios_flags()
    elif target == 'switch-arm64':
        flags.remove('--enable-ffmpeg')
        flags += switch_flags()
    elif target == 'windows-x64':
        flags = [flag for flag in flags if flag not in ('--enable-pic', '--disable-shared', '--enable-static')]
        flags += ['--enable-shared', '--disable-static', *windows_flags()]
    # configure aborts without nasm unless x86 assembly is disabled explicitly.
    if target not in ('ios-arm64', 'switch-arm64') and shutil.which('nasm') is None:
        flags.append('--disable-x86asm')
    return flags


# The LGPL license claim for the static libraries depends on this: a GPL or nonfree flag must never reach configure.
_leaked = sorted(set(configure_flags()) & set(GPL_FLAGS))
if _leaked:
    raise SystemExit(f"kz-ffmpeg: refusing to configure with {' '.join(_leaked)}")


def expected_stamp(sha, target):
    stamp = {'version': VERSION, 'sha256': sha, 'configure': configure_flags(target), 'license': LICENSE_LINE}
    if target is None and sys.platform == 'darwin':
        stamp['macos_deployment_target'] = os.environ.get('MACOSX_DEPLOYMENT_TARGET', '')
    return stamp


def current(out, sha, target):
    try:
        with open(out / STAMP) as f:
            stamp = json.load(f)
    except (OSError, ValueError):
        return False
    return stamp == expected_stamp(sha, target) and all((out / p).exists() for p in products(target))


def write_stamp(out, sha, target):
    tmp = out / (STAMP + '.kz-tmp')
    with open(tmp, 'w') as f:
        json.dump(expected_stamp(sha, target), f, indent=1, sort_keys=True)
        f.write('\n')
    os.replace(tmp, out / STAMP)


def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def download(dest, sha):
    partial = dest.with_name(dest.name + '.partial')
    for attempt in range(5):
        try:
            with urllib.request.urlopen(URL, timeout=120) as resp, partial.open('wb') as output:
                shutil.copyfileobj(resp, output)
            got = sha256_of(partial)
            if got != sha:
                raise ValueError(f'sha256 mismatch: expected {sha}, got {got}')
            partial.replace(dest)
            return
        except (OSError, HTTPException, ValueError) as err:
            partial.unlink(missing_ok=True)
            if attempt == 4:
                sys.exit(f'kz-ffmpeg: cannot download {URL} after five attempts: {err}')
            print(f'kz-ffmpeg: download failed ({err}); retrying attempt {attempt + 2}/5',
                  file=sys.stderr)
            time.sleep(2 ** attempt)


def extract(tarball, into):
    with tarfile.open(tarball) as tf:
        # Older Pythons have no extraction filters, so there the SHA-256 check is the only guard.
        if hasattr(tarfile, 'data_filter'):
            tf.extractall(into, filter='data')
        else:
            tf.extractall(into)
    src = into / f'ffmpeg-{VERSION}'
    if not src.is_dir():
        sys.exit(f'kz-ffmpeg: tarball does not contain ffmpeg-{VERSION}/')
    return src


def configure_and_build(src, out, jobs, target):
    out.mkdir(parents=True, exist_ok=True)
    result = subprocess.run(
        ['./configure', f'--prefix={out}', *configure_flags(target)],
        cwd=src, capture_output=True, text=True, encoding='utf-8', errors='replace',
    )
    log = result.stdout + result.stderr
    (out / 'configure.log').write_text(log, encoding='utf-8')
    if result.returncode != 0:
        config_log = src / 'ffbuild/config.log'
        if config_log.is_file():
            shutil.copyfile(config_log, out / 'config-test.log')
        sys.stderr.write('\n'.join(log.splitlines()[-40:]) + '\n')
        sys.exit(result.returncode)
    if LICENSE_LINE not in (line.rstrip() for line in log.splitlines()):
        sys.exit(f'kz-ffmpeg: configure did not report {LICENSE_LINE}; refusing to build')
    for cmd in (['make', f'-j{jobs}'], ['make', 'install']):
        code = subprocess.run(cmd, cwd=src).returncode
        if code != 0:
            sys.exit(code)


def main():
    parser = argparse.ArgumentParser(description=f'Build a minimal LGPL-only FFmpeg {VERSION} for the Kazarov image.')
    parser.add_argument('--out', metavar='DIR')
    parser.add_argument('--target', choices=['ios-arm64', 'switch-arm64', 'windows-x64'], help='cross-compile the libraries for this target')
    parser.add_argument('--tarball', metavar='FILE')
    parser.add_argument('--sha256', metavar='HEX')
    parser.add_argument('--jobs', type=int, default=os.cpu_count() or 1, metavar='N')
    parser.add_argument('--check', action='store_true', help='exit 0 only if DIR holds a current build')
    parser.add_argument('--print-configure', action='store_true', help='print the configure line and exit')
    args = parser.parse_args()

    if args.print_configure:
        print('configure ' + shlex.join(configure_flags(args.target)))
        return
    if args.out is None:
        parser.error('--out DIR is required')

    out = Path(args.out).resolve()
    sha = (args.sha256 or SHA256).lower()
    if args.check:
        if not current(out, sha, args.target):
            sys.exit(f'kz-ffmpeg: {out} does not hold a current build')
        return
    if current(out, sha, args.target):
        print(f'kz-ffmpeg: {out} is up to date')
        return
    (out / STAMP).unlink(missing_ok=True)

    with tempfile.TemporaryDirectory(prefix='kz-ffmpeg-') as tmp:
        tmp = Path(tmp)
        if args.tarball:
            tarball = Path(args.tarball)
        else:
            tarball = tmp / f'ffmpeg-{VERSION}.tar.xz'
            download(tarball, sha)
        got = sha256_of(tarball)
        if got != sha:
            sys.exit(f'kz-ffmpeg: {tarball} sha256 mismatch: expected {sha}, got {got}')
        src = extract(tarball, tmp)
        configure_and_build(src, out, args.jobs, args.target)

    write_stamp(out, sha, args.target)
    print(f'kz-ffmpeg: built FFmpeg {VERSION} into {out}')


if __name__ == '__main__':
    main()
