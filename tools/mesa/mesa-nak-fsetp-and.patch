+    /**
+     * Creates one comparison and a simple predicate AND with independent operands.
+     */
+    fn fixture(
+        position: usize,
+        cmp_op: FloatCmpOp,
+        ftz: bool,
+        modifier: SrcMod,
+    ) -> Vec<Instr> {
+        let mut alloc = SSAValueAllocator::new();
+        let x = alloc.alloc(RegFile::GPR);
+        let y = alloc.alloc(RegFile::GPR);
+        let other = alloc.alloc(RegFile::Pred);
+        let cmp = alloc.alloc(RegFile::Pred);
+        let dst = alloc.alloc(RegFile::Pred);
+        let mut lhs: Src = x.into();
+        lhs.src_mod = modifier;
+        let mut rhs: Src = y.into();
+        rhs.src_mod = SrcMod::FNegAbs;
+        let mut srcs = [other.into(), other.into(), true.into()];
+        srcs[position] = cmp.into();
+        vec![
+            Instr::new(OpUndef { dst: x.into() }),
+            Instr::new(OpUndef { dst: y.into() }),
+            Instr::new(OpUndef { dst: other.into() }),
+            Instr::new(OpFSetP {
+                dst: cmp.into(),
+                set_op: PredSetOp::And,
+                cmp_op,
+                srcs: [lhs, rhs],
+                accum: true.into(),
+                ftz,
+            }),
+            Instr::new(OpPSetP {
+                dsts: [dst.into(), Dst::None],
+                ops: [PredSetOp::And, PredSetOp::And],
+                srcs,
+            }),
+        ]
+    }
+
+    /**
+     * Applies the production use analysis to separate test blocks.
+     */
+    fn run(blocks: &mut [Vec<Instr>], enabled: bool, sm: u8, fragment: bool) {
+        if !fsetp_and_supported(enabled, sm, fragment) {
+            return;
+        }
+        let uses = use_counts(blocks.iter().flat_map(|block| block.iter()));
+        for block in blocks {
+            fuse_block(block, &uses);
+        }
+    }
+
