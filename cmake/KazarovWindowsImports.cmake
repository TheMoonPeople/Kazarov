# Generate LLVM short COFF imports in the build tree; dependency packages remain immutable.
include_guard(GLOBAL)

function(kz_windows_import_library target)
    if(NOT WIN32 OR NOT MINGW OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        return()
    endif()
    get_target_property(aliased ${target} ALIASED_TARGET)
    if(aliased)
        set(target "${aliased}")
    endif()
    get_target_property(imported ${target} IMPORTED)
    get_target_property(type ${target} TYPE)
    if(NOT imported OR NOT type STREQUAL "SHARED_LIBRARY")
        return()
    endif()
    get_target_property(done ${target} KZ_WINDOWS_SHORT_IMPORTS)
    if(done)
        return()
    endif()
    get_filename_component(compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    find_program(KZ_LLVM_READOBJ NAMES llvm-readobj HINTS "${compiler_bin}" NO_DEFAULT_PATH REQUIRED)
    find_program(KZ_LLVM_DLLTOOL NAMES llvm-dlltool HINTS "${compiler_bin}" NO_DEFAULT_PATH REQUIRED)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/build/windows-import-library.py")
    get_target_property(configurations ${target} IMPORTED_CONFIGURATIONS)
    set(properties IMPORTED_LOCATION)
    foreach(config IN LISTS configurations)
        string(TOUPPER "${config}" config)
        list(APPEND properties "IMPORTED_LOCATION_${config}")
    endforeach()
    foreach(property IN LISTS properties)
        get_target_property(dll ${target} ${property})
        if(NOT dll)
            continue()
        endif()
        execute_process(COMMAND "${Python3_EXECUTABLE}" "${script}" --dll "${dll}"
            --readobj "${KZ_LLVM_READOBJ}" --dlltool "${KZ_LLVM_DLLTOOL}" --describe
            OUTPUT_VARIABLE key OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE result ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot identify Windows imports for ${target}: ${error}")
        endif()
        set(directory "${CMAKE_BINARY_DIR}/kz_windows_imports/${key}")
        set(generator_target "kz_windows_imports_${key}")
        if(NOT TARGET ${generator_target})
            add_custom_command(OUTPUT "${directory}/imports.lib" "${directory}/exports.def" "${directory}/manifest.json"
                COMMAND "${Python3_EXECUTABLE}" "${script}" --dll "${dll}"
                    --readobj "${KZ_LLVM_READOBJ}" --dlltool "${KZ_LLVM_DLLTOOL}"
                    --output-dir "${directory}" --expected-key "${key}"
                DEPENDS "${dll}" "${script}" "${KZ_LLVM_READOBJ}" "${KZ_LLVM_DLLTOOL}"
                COMMENT "Generating short COFF imports for ${target}"
                VERBATIM)
            add_custom_target(${generator_target} DEPENDS "${directory}/imports.lib"
                "${directory}/exports.def" "${directory}/manifest.json")
        endif()
        string(REPLACE "IMPORTED_LOCATION" "IMPORTED_IMPLIB" import_property "${property}")
        set_property(TARGET ${target} PROPERTY ${import_property} "${directory}/imports.lib")
        add_dependencies(${target} ${generator_target})
        # Changes to an input select a new content-addressed output directory on reconfigure.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${dll}" "${script}" "${KZ_LLVM_READOBJ}" "${KZ_LLVM_DLLTOOL}")
    endforeach()
    set_property(TARGET ${target} PROPERTY KZ_WINDOWS_SHORT_IMPORTS TRUE)
endfunction()

# Keep FindVulkan's direct-DLL target intact while giving the linker short imports.
function(kz_windows_vulkan_import)
    if(TARGET kz::vulkan)
        return()
    endif()
    set(vulkan Vulkan::Vulkan)
    get_target_property(aliased ${vulkan} ALIASED_TARGET)
    if(aliased)
        set(vulkan "${aliased}")
    endif()
    get_target_property(type ${vulkan} TYPE)
    get_target_property(configurations ${vulkan} IMPORTED_CONFIGURATIONS)
    if(NOT configurations)
        set(configurations "")
    endif()
    set(location_properties IMPORTED_LOCATION)
    foreach(config IN LISTS configurations)
        string(TOUPPER "${config}" config)
        list(APPEND location_properties "IMPORTED_LOCATION_${config}")
    endforeach()
    set(has_location FALSE)
    set(dll_locations TRUE)
    foreach(property IN LISTS location_properties)
        get_target_property(location ${vulkan} ${property})
        if(location)
            set(has_location TRUE)
            if(NOT location MATCHES "\\.[dD][lL][lL]$")
                set(dll_locations FALSE)
            endif()
        endif()
    endforeach()
    if(WIN32 AND MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND
       type STREQUAL "UNKNOWN_LIBRARY" AND has_location AND dll_locations)
        add_library(kz_vulkan_loader SHARED IMPORTED GLOBAL)
        set(properties IMPORTED_LOCATION IMPORTED_CONFIGURATIONS SYSTEM
            INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
            INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES
            INTERFACE_LINK_LIBRARIES INTERFACE_LINK_LIBRARIES_DIRECT INTERFACE_LINK_LIBRARIES_DIRECT_EXCLUDE
            INTERFACE_LINK_OPTIONS INTERFACE_LINK_DIRECTORIES INTERFACE_LINK_DEPENDS)
        foreach(config IN LISTS configurations)
            string(TOUPPER "${config}" config)
            list(APPEND properties "IMPORTED_LOCATION_${config}")
        endforeach()
        foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            list(APPEND properties "MAP_IMPORTED_CONFIG_${config}")
        endforeach()
        foreach(property IN LISTS properties)
            get_target_property(value ${vulkan} ${property})
            if(NOT value STREQUAL "value-NOTFOUND")
                set_property(TARGET kz_vulkan_loader PROPERTY ${property} "${value}")
            endif()
        endforeach()
        kz_windows_import_library(kz_vulkan_loader)
        add_library(kz::vulkan ALIAS kz_vulkan_loader)
    else()
        if(WIN32 AND MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND
           type STREQUAL "SHARED_LIBRARY")
            kz_windows_import_library(${vulkan})
        endif()
        add_library(kz::vulkan ALIAS ${vulkan})
    endif()
endfunction()
