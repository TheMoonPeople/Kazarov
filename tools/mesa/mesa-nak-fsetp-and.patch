+    #[test]
+    fn preserves_two_comparison_chains_and_grouped_guards() {
+        for (groups, leaves) in [(1, 2), (1, 4), (2, 4)] {
+            let mut alloc = SSAValueAllocator::new();
+            let x = alloc.alloc(RegFile::GPR);
+            let mut instrs = vec![Instr::new(OpUndef { dst: x.into() })];
+            let mut final_value: Option<SSAValue> = None;
+            for group in 0..groups {
+                let mut result: Option<SSAValue> = None;
+                for leaf in 0..leaves {
+                    let cmp = alloc.alloc(RegFile::Pred);
+                    instrs.push(Instr::new(OpFSetP {
+                        dst: cmp.into(),
+                        set_op: PredSetOp::And,
+                        cmp_op: FloatCmpOp::OrdLe,
+                        srcs: [
+                            x.into(),
+                            Src::new_imm_u32(group * leaves + leaf),
+                        ],
+                        accum: true.into(),
+                        ftz: true,
+                    }));
+                    result = Some(if let Some(previous) = result {
+                        let next = alloc.alloc(RegFile::Pred);
+                        instrs.push(Instr::new(OpPSetP {
+                            dsts: [next.into(), Dst::None],
+                            ops: [PredSetOp::And, PredSetOp::And],
+                            srcs: [previous.into(), cmp.into(), true.into()],
+                        }));
+                        next
+                    } else {
+                        cmp
+                    });
+                }
+                final_value = Some(if let Some(previous) = final_value {
+                    let next = alloc.alloc(RegFile::Pred);
+                    instrs.push(Instr::new(OpPSetP {
+                        dsts: [next.into(), Dst::None],
+                        ops: [PredSetOp::And, PredSetOp::And],
+                        srcs: [
+                            previous.into(),
+                            result.unwrap().into(),
+                            true.into(),
+                        ],
+                    }));
+                    next
+                } else {
+                    result.unwrap()
+                });
+            }
+            let evaluate = |code: &[Instr], truth: u32| {
+                let mut values = FxHashMap::<SSAValue, bool>::default();
+                let read = |src: &Src, values: &FxHashMap<SSAValue, bool>| {
+                    if literal_true(src) {
+                        true
+                    } else {
+                        values[&predicate_ssa(src).unwrap()]
+                    }
+                };
+                for instr in code {
+                    let (dst, value) = match &instr.op {
+                        Op::FSetP(op) => {
+                            let index = match op.srcs[1].src_ref {
+                                SrcRef::Zero => 0,
+                                SrcRef::Imm32(index) => index,
+                                _ => panic!(),
+                            };
+                            let value = op.set_op.eval(
+                                (truth & (1 << index)) != 0,
+                                read(&op.accum, &values),
+                            );
+                            (&op.dst, value)
+                        }
+                        Op::PSetP(op) => (
+                            &op.dsts[0],
+                            op.ops[1].eval(
+                                read(&op.srcs[2], &values),
+                                op.ops[0].eval(
+                                    read(&op.srcs[0], &values),
+                                    read(&op.srcs[1], &values),
+                                ),
+                            ),
+                        ),
+                        _ => continue,
+                    };
+                    let Dst::SSA(dst) = dst else { panic!() };
+                    values.insert(dst[0], value);
+                }
+                values[&final_value.unwrap()]
+            };
+            let expected = (0..(1 << (groups * leaves)))
+                .map(|truth| evaluate(&instrs, truth))
+                .collect::<Vec<_>>();
+            let mut blocks = [instrs];
+            run(&mut blocks, true, 53, true);
+            assert_eq!(
+                blocks[0]
+                    .iter()
+                    .filter(|i| matches!(i.op, Op::FSetP(_)))
+                    .count(),
+                (groups * leaves) as usize
+            );
+            assert_eq!(
+                blocks[0]
+                    .iter()
+                    .filter(|i| matches!(i.op, Op::PSetP(_)))
+                    .count(),
+                (groups - 1) as usize
+            );
+            for (truth, value) in expected.into_iter().enumerate() {
+                assert_eq!(evaluate(&blocks[0], truth as u32), value);
+            }
+        }
+    }
+}
