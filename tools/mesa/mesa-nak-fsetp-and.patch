+// SPDX-License-Identifier: MIT
+
+use crate::ir::*;
+use rustc_hash::FxHashMap;
+
+/**
+ * Restricts predicate fusion to enabled fragment shaders in the SM50 family.
+ */
+pub(crate) fn fsetp_and_supported(
+    enabled: bool,
+    sm: u8,
+    fragment: bool,
+) -> bool {
+    enabled && fragment && (50..70).contains(&sm)
+}
+
+/**
+ * Identifies a single unmodified predicate SSA operand.
+ */
+fn predicate_ssa(src: &Src) -> Option<SSAValue> {
+    if !src.is_unmodified() {
+        return None;
+    }
+    match &src.src_ref {
+        SrcRef::SSA(ssa) if ssa.comps() == 1 && ssa.file() == RegFile::Pred => {
+            Some(ssa[0])
+        }
+        _ => None,
+    }
+}
+
+/**
+ * Recognizes the literal predicate identity without accepting inversions.
+ */
+fn literal_true(src: &Src) -> bool {
+    src.is_unmodified() && matches!(&src.src_ref, SrcRef::True)
+}
+
+/**
+ * Restricts comparison motion to immutable scalar values and constants.
+ */
+fn immutable_float(src: &Src) -> bool {
+    let immutable = match &src.src_ref {
+        SrcRef::SSA(ssa) => ssa.comps() == 1 && ssa.file() == RegFile::GPR,
+        SrcRef::Imm32(_) | SrcRef::Zero => true,
+        _ => false,
+    };
+    immutable
+        && src.src_swizzle.is_none()
+        && matches!(
+            src.src_mod,
+            SrcMod::None | SrcMod::FAbs | SrcMod::FNeg | SrcMod::FNegAbs
+        )
+}
+
+/**
+ * Counts every SSA use, including instruction predicates and phi operands.
+ */
+fn use_counts<'a>(
+    instrs: impl Iterator<Item = &'a Instr>,
+) -> FxHashMap<SSAValue, u32> {
+    let mut uses = FxHashMap::default();
+    for instr in instrs {
+        for ssa in instr.ssa_uses() {
+            *uses.entry(*ssa).or_insert(0) += 1;
+        }
+    }
+    uses
+}
+
+/**
+ * Preserves the operands of one comparison while replacing its sole AND use.
+ */
+fn fuse_block(instrs: &mut Vec<Instr>, uses: &FxHashMap<SSAValue, u32>) {
+    let mut pending: Vec<Option<Instr>> =
+        std::mem::take(instrs).into_iter().map(Some).collect();
+    let mut defs = FxHashMap::<SSAValue, usize>::default();
+    for ip in 0..pending.len() {
+        let fusion = (|| {
+            let consumer = pending[ip].as_ref()?;
+            if !consumer.pred.is_true() {
+                return None;
+            }
+            let Op::PSetP(and) = &consumer.op else {
+                return None;
+            };
+            if !and.dsts[1].is_none()
+                || and.ops != [PredSetOp::And, PredSetOp::And]
+                || !literal_true(&and.srcs[2])
+            {
+                return None;
+            }
+            let Dst::SSA(dst) = &and.dsts[0] else {
+                return None;
+            };
+            if dst.comps() != 1 || dst.file() != RegFile::Pred {
+                return None;
+            }
+            for operand in 0..2 {
+                let Some(result) = predicate_ssa(&and.srcs[operand]) else {
+                    continue;
+                };
+                if uses.get(&result) != Some(&1) {
+                    continue;
+                }
+                let Some(&producer_ip) = defs.get(&result) else {
+                    continue;
+                };
+                let producer = pending[producer_ip].as_ref()?;
+                let Op::FSetP(cmp) = &producer.op else {
+                    continue;
+                };
+                if !producer.pred.is_true()
+                    || cmp.set_op != PredSetOp::And
+                    || !literal_true(&cmp.accum)
+                    || cmp.srcs.iter().any(|src| !immutable_float(src))
+                {
+                    continue;
+                }
+                let Some(other) = predicate_ssa(&and.srcs[1 - operand]) else {
+                    continue;
+                };
+                let Some(&other_ip) = defs.get(&other) else {
+                    continue;
+                };
+                if matches!(&pending[other_ip].as_ref()?.op, Op::PhiDsts(_)) {
+                    continue;
+                }
+                return Some((
+                    producer_ip,
+                    result,
+                    and.dsts[0].clone(),
+                    and.srcs[1 - operand].clone(),
+                ));
+            }
+            None
+        })();
+        if let Some((producer_ip, result, dst, accum)) = fusion {
+            let producer = pending[producer_ip].take().unwrap();
+            let Op::FSetP(mut cmp) = producer.op else {
+                unreachable!();
+            };
+            cmp.dst = dst;
+            cmp.accum = accum;
+            pending[ip].as_mut().unwrap().op = Op::FSetP(cmp);
+            defs.remove(&result);
+        }
+        pending[ip].as_ref().unwrap().for_each_ssa_def(|ssa| {
+            defs.insert(*ssa, ip);
+        });
+    }
+    *instrs = pending.into_iter().flatten().collect();
+}
+
+impl Shader<'_> {
+    /**
+     * Fuses exact single-use float comparisons with same-block predicate ANDs.
+     */
+    pub fn opt_fsetp_and(&mut self) {
+        for function in &mut self.functions {
+            let uses = use_counts(
+                function.blocks.iter().flat_map(|block| block.instrs.iter()),
+            );
+            for block in &mut function.blocks {
+                fuse_block(&mut block.instrs, &uses);
+            }
+        }
+    }
+}
