+#[cfg(test)]
+mod fsetp_and_option_tests {
+    use super::*;
+
+    #[test]
+    fn parses_only_literal_one_and_preserves_existing_flag_bits() {
+        for value in [None, Some(""), Some("0"), Some("01"), Some("true"), Some("1 ")] {
+            assert_eq!(fsetp_and_option(value), 0);
+        }
+        assert_eq!(fsetp_and_option(Some("1")), 128);
+        for old in 0..128_u32 {
+            assert_eq!(old | fsetp_and_option(None), old);
+            assert_eq!(old | fsetp_and_option(Some("0")), old);
+            assert_eq!(old | fsetp_and_option(Some("1")), old + 128);
+            let off_key = u64::from(old) << 48;
+            let on_key = u64::from(old | fsetp_and_option(Some("1"))) << 48;
+            assert_ne!(off_key, on_key);
+        }
+    }
